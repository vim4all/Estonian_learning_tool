{
  "id": "comparatives",
  "title": { "en": "Comparatives & Superlatives", "et": "Võrdlusastmed", "uk": "Ступені порівняння" },
  "level": "B1",
  "order": 25,
  "sentences": [
    { "id": "comparatives-01", "en": "My brother is taller than me.", "et": "Minu vend on pikem kui mina.", "uk": "Мій брат вищий за мене.", "notes": "Comparative = genitive stem + \"-m\": pikk → pika → pikem.", "words": [{ "et": "pikem", "en": "taller", "uk": "вищий", "lemma": "pikk", "pos": "adjective", "ipa": "ˈpikem" }] },
    { "id": "comparatives-02", "en": "This house is bigger than that one.", "et": "See maja on suurem kui too.", "uk": "Цей будинок більший за той.", "words": [{ "et": "suurem", "en": "bigger", "uk": "більший", "lemma": "suur", "pos": "adjective", "ipa": "ˈsuːrem" }, { "et": "too", "en": "that (one)", "uk": "той", "lemma": "too", "pos": "pronoun", "ipa": "toː" }] },
    { "id": "comparatives-03", "en": "Today is colder than yesterday.", "et": "Täna on külmem kui eile.", "uk": "Сьогодні холодніше, ніж учора.", "words": [{ "et": "külmem", "en": "colder", "uk": "холодніший", "lemma": "külm", "pos": "adjective", "ipa": "ˈkylmem" }] },
    { "id": "comparatives-04", "en": "This is the best restaurant.", "et": "See on parim restoran.", "uk": "Це найкращий ресторан.", "notes": "\"hea\" (good) is irregular: hea → parem (better) → parim (best).", "words": [{ "et": "parim", "en": "best", "uk": "найкращий", "lemma": "hea", "pos": "adjective", "ipa": "ˈpɑrim" }] },
    { "id": "comparatives-05", "en": "This is the tallest building.", "et": "See on kõige kõrgem hoone.", "uk": "Це найвища будівля.", "notes": "\"kõrge\" (tall/high) is used for buildings; \"pikk\" is for people or length.", "words": [{ "et": "kõige kõrgem", "en": "the tallest", "uk": "найвищий", "lemma": "kõrge", "pos": "adjective", "ipa": "ˈkɤiɡe ˈkɤrɡem" }, { "et": "hoone", "en": "building", "uk": "будівля", "lemma": "hoone", "pos": "noun", "ipa": "ˈhoːne" }] },
    { "id": "comparatives-06", "en": "She is younger than her brother.", "et": "Tema on noorem kui tema vend.", "uk": "Вона молодша за свого брата.", "words": [{ "et": "noorem", "en": "younger", "uk": "молодший", "lemma": "noor", "pos": "adjective", "ipa": "ˈnoːrem" }] },
    { "id": "comparatives-07", "en": "This is the smallest room.", "et": "See on kõige väiksem tuba.", "uk": "Це найменша кімната.", "words": [{ "et": "kõige väiksem", "en": "the smallest", "uk": "найменший", "lemma": "väike", "pos": "adjective", "ipa": "ˈkɤiɡe ˈvæiksem" }] },
    { "id": "comparatives-08", "en": "My friend is older than me.", "et": "Minu sõber on vanem kui mina.", "uk": "Мій друг старший за мене.", "words": [{ "et": "vanem", "en": "older", "uk": "старший", "lemma": "vana", "pos": "adjective", "ipa": "ˈvɑnem" }] },
    { "id": "comparatives-09", "en": "This coffee is better than that one.", "et": "See kohv on parem kui too.", "uk": "Ця кава краща за ту.", "words": [{ "et": "parem", "en": "better", "uk": "кращий", "lemma": "hea", "pos": "adjective", "ipa": "ˈpɑrem" }] },
    { "id": "comparatives-10", "en": "This is worse.", "et": "See on halvem.", "uk": "Це гірше.", "notes": "\"halb\" (bad) is also irregular: halb → halvem → halvim.", "words": [{ "et": "halvem", "en": "worse", "uk": "гірший", "lemma": "halb", "pos": "adjective", "ipa": "ˈhɑlvem" }] }
  ]
}
