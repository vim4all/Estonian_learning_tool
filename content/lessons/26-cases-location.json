    { "id": "cases-location-01", "en": "I am at school.", "et": "Ma olen koolis.", "notes": "Inessive (\"in\"): kool → koolis.", "words": [{ "et": "koolis", "en": "at/in school", "lemma": "kool", "pos": "noun", "ipa": "ˈkoːlis" }] },
