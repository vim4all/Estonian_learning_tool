    { "id": "cases-location-03", "en": "I am coming from school.", "et": "Ma tulen koolist.", "uk": "Я йду зі школи.", "notes": "Elative (\"out of\"): kool → koolist. Together, koolis/kooli/koolist are the \"internal\" location case set.", "words": [{ "et": "koolist", "en": "from school", "uk": "зі школи", "lemma": "kool", "pos": "noun", "ipa": "ˈkoːlist" }] },
    { "id": "cases-location-04", "en": "The book is on the table.", "et": "Raamat on laual.", "uk": "Книга на столі.", "notes": "Adessive (\"on/at\"): laud → laual.", "words": [{ "et": "laual", "en": "on the table", "uk": "на столі", "lemma": "laud", "pos": "noun", "ipa": "ˈlɑuɑl" }] },
