    { "id": "cases-location-01", "en": "I am at school.", "et": "Ma olen koolis.", "uk": "Я в школі.", "notes": "Inessive (\"in\"): kool → koolis.", "words": [{ "et": "koolis", "en": "at/in school", "uk": "у школі", "lemma": "kool", "pos": "noun", "ipa": "ˈkoːlis" }] },
