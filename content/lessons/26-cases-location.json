    { "id": "cases-location-03", "en": "I am coming from school.", "et": "Ma tulen koolist.", "notes": "Elative (\"out of\"): kool → koolist. Together, koolis/kooli/koolist are the \"internal\" location case set.", "words": [{ "et": "koolist", "en": "from school", "lemma": "kool", "pos": "noun", "ipa": "ˈkoːlist" }] },
    { "id": "cases-location-04", "en": "The book is on the table.", "et": "Raamat on laual.", "notes": "Adessive (\"on/at\"): laud → laual.", "words": [{ "et": "laual", "en": "on the table", "lemma": "laud", "pos": "noun", "ipa": "ˈlɑuɑl" }] },
    { "id": "cases-location-05", "en": "I am putting the book on the table.", "et": "Ma panen raamatu lauale.", "notes": "Allative (\"onto\"): laud → lauale.", "words": [{ "et": "lauale", "en": "onto the table", "lemma": "laud", "pos": "noun", "ipa": "ˈlɑuɑle" }] },
    { "id": "cases-location-06", "en": "The cup fell off the table.", "et": "Tass kukkus laualt maha.", "notes": "Ablative (\"off/from\"): laud → laualt. Together, laual/lauale/laualt are the \"external\" location case set.", "words": [{ "et": "laualt", "en": "off the table", "lemma": "laud", "pos": "noun", "ipa": "ˈlɑuɑlt" }] },
