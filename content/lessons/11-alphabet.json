    { "id": "alphabet-06", "en": "Š as in chocolate.", "et": "Š nagu šokolaad.", "uk": "«Š» як у слові «шоколад».", "notes": "\"Š\"/\"Ž\" only appear in loanwords.", "words": [{ "et": "šokolaad", "en": "chocolate", "uk": "шоколад", "lemma": "šokolaad", "pos": "noun", "ipa": "ˈʃokolɑːt" }] },
