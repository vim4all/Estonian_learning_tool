    { "id": "alphabet-01", "en": "A as in car.", "et": "A nagu auto.", "uk": "«A» як у слові «автомобіль».", "words": [{ "et": "auto", "en": "car", "uk": "автомобіль", "lemma": "auto", "pos": "noun", "ipa": "ˈɑuto" }] },
    { "id": "alphabet-02", "en": "Õ as in apple.", "et": "Õ nagu õun.", "uk": "«Õ» як у слові «яблуко».", "notes": "\"Õ\" has no English equivalent — a close-mid back unrounded vowel, distinct from \"o\".", "words": [{ "et": "õun", "en": "apple", "uk": "яблуко", "lemma": "õun", "pos": "noun", "ipa": "ˈɤun" }] },
