{
  "id": "necessity",
  "title": { "en": "Necessity & Obligation", "et": "Vajalikkus ja kohustus", "uk": "Необхідність та обов'язок" },
  "level": "B1",
  "order": 30,
  "sentences": [
    { "id": "necessity-01", "en": "I must go now.", "et": "Ma pean nüüd minema.", "uk": "Я мушу зараз йти.", "words": [{ "et": "pean", "en": "must", "uk": "мушу / повинен", "lemma": "pidama", "pos": "verb", "ipa": "peɑn" }] },
    { "id": "necessity-02", "en": "You must study.", "et": "Sa pead õppima.", "uk": "Ти повинен вчитися.", "words": [{ "et": "pead", "en": "must", "uk": "повинен / мусиш", "lemma": "pidama", "pos": "verb", "ipa": "peɑt" }] },
    { "id": "necessity-03", "en": "You have to wait.", "et": "Sa pead ootama.", "uk": "Ти маєш почекати.", "words": [{ "et": "ootama", "en": "to wait", "uk": "чекати", "lemma": "ootama", "pos": "verb", "ipa": "ˈoːtɑmɑ" }] },
    { "id": "necessity-04", "en": "I need water.", "et": "Mul on vett vaja.", "uk": "Мені потрібна вода.", "words": [{ "et": "vaja", "en": "needed", "uk": "потрібно / треба", "lemma": "vaja", "pos": "adverb", "ipa": "ˈvɑjɑ" }] },
    { "id": "necessity-05", "en": "I need help.", "et": "Mul on abi vaja.", "uk": "Мені потрібна допомога.", "words": [{ "et": "abi", "en": "help", "uk": "допомога", "lemma": "abi", "pos": "noun", "ipa": "ˈɑbi" }] },
    { "id": "necessity-06", "en": "It is not necessary.", "et": "Seda ei ole vaja.", "uk": "Це не обов'язково.", "words": [{ "et": "seda", "en": "it / this (partitive)", "uk": "це (партитив)", "lemma": "see", "pos": "pronoun", "ipa": "ˈsedɑ" }] },
    { "id": "necessity-07", "en": "I must eat something.", "et": "Ma pean midagi sööma.", "uk": "Я мушу щось з'їсти.", "words": [{ "et": "midagi", "en": "something", "uk": "щось", "lemma": "midagi", "pos": "pronoun", "ipa": "ˈmidɑɡi" }] },
    { "id": "necessity-08", "en": "We must hurry.", "et": "Me peame kiirustama.", "uk": "Ми повинні поспішати.", "words": [{ "et": "peame", "en": "must", "uk": "повинні / мусимо", "lemma": "pidama", "pos": "verb", "ipa": "peɑme" }, { "et": "kiirustama", "en": "to hurry", "uk": "поспішати", "lemma": "kiirustama", "pos": "verb", "ipa": "ˈkiːrustɑmɑ" }] },
    { "id": "necessity-09", "en": "I don't have to work today.", "et": "Ma ei pea täna töötama.", "uk": "Мені не треба сьогодні працювати.", "words": [{ "et": "ei pea", "en": "don't have to", "uk": "не треба / не мушу", "lemma": "pidama", "pos": "verb", "ipa": "ei peɑ" }] },
    { "id": "necessity-10", "en": "It is important to rest.", "et": "On tähtis puhata.", "uk": "Важливо відпочивати.", "words": [{ "et": "tähtis", "en": "important", "uk": "важливий", "lemma": "tähtis", "pos": "adjective", "ipa": "ˈtæhtis" }, { "et": "puhata", "en": "to rest", "uk": "відпочивати", "lemma": "puhkama", "pos": "verb", "ipa": "ˈpuhɑtɑ" }] }
  ]
}
