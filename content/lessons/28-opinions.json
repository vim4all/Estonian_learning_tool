{
  "id": "opinions",
  "title": { "en": "Opinions & Preferences", "et": "Arvamused ja eelistused", "uk": "Думки та вподобання" },
  "level": "B1",
  "order": 28,
  "sentences": [
    { "id": "opinions-01", "en": "In my opinion, this is a good idea.", "et": "Minu arvates on see hea mõte.", "uk": "На мою думку, це хороша ідея.", "words": [{ "et": "minu arvates", "en": "in my opinion", "uk": "на мою думку", "lemma": "arvates", "pos": "adverb", "ipa": "ˈminu ˈɑrvɑtes" }, { "et": "mõte", "en": "idea / thought", "uk": "ідея / думка", "lemma": "mõte", "pos": "noun", "ipa": "ˈmɤte" }] },
    { "id": "opinions-02", "en": "I think that Estonian is not difficult.", "et": "Ma arvan, et eesti keel ei ole raske.", "uk": "Я думаю, що естонська мова не важка.", "words": [{ "et": "arvan", "en": "think", "uk": "думаю", "lemma": "arvama", "pos": "verb", "ipa": "ˈɑrvɑn" }, { "et": "raske", "en": "difficult", "uk": "важкий", "lemma": "raske", "pos": "adjective", "ipa": "ˈrɑske" }] },
    { "id": "opinions-03", "en": "I think that this is correct.", "et": "Ma arvan, et see on õige.", "uk": "Я думаю, що це правильно.", "words": [{ "et": "õige", "en": "correct / right", "uk": "правильний / вірний", "lemma": "õige", "pos": "adjective", "ipa": "ˈɤiɡe" }] },
    { "id": "opinions-04", "en": "It seems to me that it will rain.", "et": "Mulle tundub, et hakkab sadama.", "uk": "Мені здається, що піде дощ.", "words": [{ "et": "tundub", "en": "seems", "uk": "здається", "lemma": "tunduma", "pos": "verb", "ipa": "ˈtundup" }] },
    { "id": "opinions-05", "en": "I prefer tea to coffee.", "et": "Ma eelistan teed kohvile.", "uk": "Я віддаю перевагу чаю, а не каві.", "notes": "\"eelistama\" (\"to prefer\") takes a partitive object and an allative \"to\": teed (tea, partitive) kohvile (to coffee, allative).", "words": [{ "et": "eelistan", "en": "prefer", "uk": "віддаю перевагу", "lemma": "eelistama", "pos": "verb", "ipa": "ˈeːlistɑn" }] },
    { "id": "opinions-06", "en": "In my opinion, this book is interesting.", "et": "Minu arvates on see raamat huvitav.", "uk": "На мою думку, ця книга цікава.", "words": [{ "et": "huvitav", "en": "interesting", "uk": "цікавий", "lemma": "huvitav", "pos": "adjective", "ipa": "ˈhuvitɑv" }] },
    { "id": "opinions-07", "en": "I don't think so.", "et": "Ma ei arva nii.", "uk": "Я так не думаю.", "words": [{ "et": "nii", "en": "so / like that", "uk": "так / отак", "lemma": "nii", "pos": "adverb", "ipa": "niː" }] },
    { "id": "opinions-08", "en": "What do you think?", "et": "Mida sa arvad?", "uk": "Що ти думаєш?", "words": [{ "et": "mida", "en": "what (partitive)", "uk": "що (партитив)", "lemma": "mis", "pos": "pronoun", "ipa": "ˈmidɑ" }] },
    { "id": "opinions-09", "en": "I agree.", "et": "Ma olen nõus.", "uk": "Я згоден.", "words": [{ "et": "nõus", "en": "in agreement", "uk": "згоден", "lemma": "nõus", "pos": "adjective", "ipa": "nɤus" }] },
    { "id": "opinions-10", "en": "I disagree.", "et": "Ma ei ole nõus.", "uk": "Я не згоден.", "words": [{ "et": "nõus", "en": "in agreement", "uk": "згоден", "lemma": "nõus", "pos": "adjective", "ipa": "nɤus" }] }
  ]
}
