  "sentences": [
    { "id": "family-01", "en": "This is my mother.", "et": "See on minu ema.", "uk": "Це моя мати.", "words": [{ "et": "ema", "en": "mother", "uk": "мати", "lemma": "ema", "pos": "noun", "ipa": "ˈemɑ" }] },
    { "id": "family-02", "en": "This is my father.", "et": "See on minu isa.", "uk": "Це мій батько.", "words": [{ "et": "isa", "en": "father", "uk": "батько", "lemma": "isa", "pos": "noun", "ipa": "ˈisɑ" }] },
    { "id": "family-03", "en": "I have a sister.", "et": "Mul on õde.", "uk": "У мене є сестра.", "words": [{ "et": "õde", "en": "sister", "uk": "сестра", "lemma": "õde", "pos": "noun", "ipa": "ˈɤde" }] },
    { "id": "family-04", "en": "I have a brother.", "et": "Mul on vend.", "uk": "У мене є брат.", "words": [{ "et": "vend", "en": "brother", "uk": "брат", "lemma": "vend", "pos": "noun", "ipa": "vend" }] },
    { "id": "family-05", "en": "This is my grandmother.", "et": "See on minu vanaema.", "uk": "Це моя бабуся.", "words": [{ "et": "vanaema", "en": "grandmother", "uk": "бабуся", "lemma": "vanaema", "pos": "noun", "ipa": "ˈvɑnɑˌemɑ" }] },
    { "id": "family-06", "en": "This is my grandfather.", "et": "See on minu vanaisa.", "uk": "Це мій дідусь.", "words": [{ "et": "vanaisa", "en": "grandfather", "uk": "дідусь", "lemma": "vanaisa", "pos": "noun", "ipa": "ˈvɑnɑˌisɑ" }] },
    { "id": "family-07", "en": "I have a son.", "et": "Mul on poeg.", "uk": "У мене є син.", "words": [{ "et": "poeg", "en": "son", "uk": "син", "lemma": "poeg", "pos": "noun", "ipa": "poeɡ" }] },
    { "id": "family-08", "en": "I have a daughter.", "et": "Mul on tütar.", "uk": "У мене є дочка.", "words": [{ "et": "tütar", "en": "daughter", "uk": "дочка", "lemma": "tütar", "pos": "noun", "ipa": "ˈtytɑr" }] },
